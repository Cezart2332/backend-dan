{
  "expo": {
    "name": "Dan fost anxios",
    "slug": "dan-fost-anxios",
    "scheme": "danfostanxios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/Icon-Store-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/ios/Icon-Store-1024.png",
      "bundleIdentifier": "com.cartealuidan.danfostanxios",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Permite notificări pentru a primi gândul zilnic de la Dan.",
        "NSCameraUsageDescription": "Această aplicație nu folosește camera, dar unele biblioteci terțe pot solicita acest acces.",
        "NSPhotoLibraryUsageDescription": "Această aplicație nu folosește galeria foto, dar unele biblioteci terțe pot solicita acest acces.",
        "NSMicrophoneUsageDescription": "Această aplicație nu folosește microfonul, dar unele biblioteci terțe pot solicita acest acces.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "icon": "./assets/android/mipmap-xxxhdpi/ic_launcher.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cartealuidan.danfostanxios",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-video",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://api.danfostanxios.ro",
      "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_PmKTgPqleLWWTmQYOWGzJCdQoyC",
      "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_NpHcWatEEingJfytKUnZwRokETY",
      "EXPO_PUBLIC_REVENUECAT_API_KEY": "",
      "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT": "Dan Fost Anxios Pro",
      "eas": {
        "projectId": "d9f73843-db4d-441f-9a97-1cb350a7900b"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "cartealuidan"
  }
}
