# Example environment configuration (DO NOT COMMIT real secrets)

# Core app
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:19006

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=default
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_CONNECT_TIMEOUT=5000
MYSQL_CONNECTION_LIMIT=24
MYSQL_MAX_IDLE=12
MYSQL_IDLE_TIMEOUT=60000
MYSQL_QUEUE_LIMIT=96
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_ENABLE_KEEP_ALIVE=true
MYSQL_KEEP_ALIVE_INITIAL_DELAY=10000

# JWT / Auth
JWT_SECRET=change_me_jwt
LOG_LEVEL=info
COMPRESS_THRESHOLD_BYTES=1024

# Disable Node media byte streaming in production (Nginx serves /api/media/* directly)
ENABLE_NODE_MEDIA_STREAMING=false

# Optional small read-side caches
ADMIN_STATS_CACHE_TTL_MS=15000
REVENUECAT_CURRENT_CACHE_TTL_MS=30000
REVENUECAT_CACHE_MAX_ENTRIES=5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.danfostanxios.ro/api/auth/callback/google

# Apple OAuth
APPLE_CLIENT_ID=com.cartealuidan.danfostanxios
APPLE_PRIVATE_KEY=your_apple_private_key

# Stripe (Test mode placeholders)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Subscription plan mapping:
# Each can be EITHER a Price ID (price_...) OR a Product ID (prod_...).
# If you provide a Product ID, the server will resolve its default_price (or first active price).
# Make sure each product has an active recurring price in Stripe.
SUBSCRIPTION_PRICE_BASIC=prod_or_price_basic
SUBSCRIPTION_PRICE_PREMIUM=prod_or_price_premium
SUBSCRIPTION_PRICE_VIP=prod_or_price_vip

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=Dan fost anxios <no-reply@danfostanxios.ro>
FRONTEND_URL=https://danfostanxios.ro

# Optional defaults for scripts/load-test.js
LOAD_TEST_BASE_URL=http://127.0.0.1:3000
LOAD_TEST_ENDPOINTS=GET:/health
LOAD_TEST_CONCURRENCY=30
LOAD_TEST_DURATION_SEC=60
LOAD_TEST_TIMEOUT_MS=8000

